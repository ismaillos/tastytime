# Database
DATABASE_URL=postgresql://tastytime:tastytime_dev@localhost:5432/tastytime

# Redis
REDIS_URL=redis://localhost:6379

# Auth
BETTER_AUTH_SECRET=change-me-in-production-32-chars-min
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@tastytime.ma

# Push Notifications (VAPID)
VAPID_SUBJECT=mailto:admin@tastytime.ma
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tastytime-media

# API
PORT=4000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NODE_ENV=development

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TENANT_SLUG=tastytime
