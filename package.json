    "@tastytime/i18n": "workspace:*",
    "@tastytime/logger": "workspace:*",
    "@tastytime/types": "workspace:*",
    "@tastytime/ui": "workspace:*",
    "@tastytime/validators": "workspace:*",
    "@types/pg": "^8.20.0",
    "better-auth": "^1.2.7",
    "bullmq": "^5.27.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "framer-motion": "^12.0.6",
    "hono": "^4.12.26",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.15",
    "next": "^15.1.3",
    "next-intl": "^4.0.2",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.13.3",
    "resend": "^4.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "twilio": "^5.3.7",
