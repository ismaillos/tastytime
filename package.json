{
  "name": "tastytime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "api:dev": "tsx watch apps/api/src/index.ts",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node apps/api/dist/index.js",
