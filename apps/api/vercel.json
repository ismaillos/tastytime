{
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @tastytime/api build",
  "installCommand": "echo 'install handled by buildCommand'",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
